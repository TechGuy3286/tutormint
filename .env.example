# Supabase (the only backend)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred name for the browser key; ANON_KEY is the legacy fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never NEXT_PUBLIC_, never imported from a client component.
# Used for tables no browser may touch: phone_otps, notifications,
# usage_counters, subscriptions, the audit and activity logs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. Used only by scripts/ (seed, schema verification,
# RLS audit, backup), never by the app. Production is Mumbai (ap-south-1); the
# session-pooler host is aws-0-ap-south-1.pooler.supabase.com:5432 and the
# password must be percent-encoded.
SUPABASE_DB_URL=

# Optional. An explicit path to a psql binary for scripts/verify-schema.ts and
# scripts/rls-audit.ts. Both search for one before falling back to Docker, so
# the schema check does not stop working because Docker Desktop happens not to
# be running. Set this only when psql is installed somewhere the search misses
# (it already tries PATH, /usr/bin, /usr/local/bin and the standard Windows
# "Program Files/PostgreSQL/<17|16>/bin" locations).
PSQL_PATH=

# YouTube Data API — tutor verification videos, uploaded as private
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must point at /api/auth/youtube/callback (moved: /api/auth/callback is now
# the Supabase email-confirmation handler).
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=

# Development only: a fixed OTP code that always passes, so multiple test
# users can verify a phone number. Never read when NODE_ENV=production.
DEV_DEFAULT_OTP=000000

# ---------------------------------------------------------------- payments --
# See "Payments" in CLAUDE.md for the adapter contract.

# AssanPay. The gateway is unreachable until ALL FOUR of these are set, so a
# half-configured deploy falls back to manual transfer rather than sending a
# member to a checkout that cannot complete. Field names inside the adapter are
# marked TODO(assanpay) until their documentation is in hand.
ASSANPAY_BASE_URL=
ASSANPAY_MERCHANT_ID=
ASSANPAY_API_KEY=
ASSANPAY_WEBHOOK_SECRET=

# Test gateway. Requires NODE_ENV != production AND both of these; there is no
# default secret anywhere in the code, because a signature check that passes
# with no secret is not a check.
PAYMENTS_SIMULATOR=false
PAYMENTS_SIMULATOR_SECRET=

# Daily subscription sweep (/api/cron/subscriptions), sent by Vercel Cron as
# `Authorization: Bearer <secret>`. When unset the route refuses everything:
# an open endpoint that expires subscriptions is a denial of service.
CRON_SECRET=

# Manual-transfer account details. Overridden by app_settings rows
# (pay.bank_name, pay.account_title, pay.iban, pay.jazzcash, pay.easypaisa) so
# an admin can change them without a deploy. A channel with no details is not
# offered to members rather than shown blank.
MANUAL_PAY_BANK_NAME=
MANUAL_PAY_ACCOUNT_TITLE=
MANUAL_PAY_IBAN=

# Faysal Bank email reader (owner, 26 Oct 2026) — a BANK-ONLY mailbox that
# receives Faysal Bank credit alerts. Off until the Owner switches it on in
# Admin → Finance → Settings. Never printed or logged.
BANK_IMAP_HOST=
BANK_IMAP_PORT=993
BANK_IMAP_USER=
BANK_IMAP_PASSWORD=
MANUAL_PAY_JAZZCASH=
MANUAL_PAY_EASYPAISA=

# ------------------------------------------------------------- delivery ----
# Email, through Resend. Without a key: development prints the message to the
# server log; PRODUCTION SENDS NOTHING and says so at startup. The sending
# domain must be verified in Resend or every send is rejected.
RESEND_API_KEY=
# Optional override. Defaults to "TutorMint <noreply@tutormint.org>".
MAIL_FROM=

# OTP delivery — one-time codes for phone verification.
#
# SendPK — the ONLY SMS provider for phone verification and password-reset codes.
# All four are required; with any missing, no code can be sent by SMS and
# instrumentation.ts warns at startup naming the missing ones.
SENDPK_API_KEY=
SENDPK_SENDER=
SENDPK_TEMPLATE_ID=
SENDPK_BASE_URL=

# BRIDGE OTP — the stopgap that let a shared code verify any signup before a real
# provider existed (owner, Sunday 6 Sep). Allowed in production, unlike
# DEV_DEFAULT_OTP. Requires BOTH a code and a FUTURE expiry date to be active
# (no expiry ⇒ never active). It is a backstop only; REMOVE both once real
# SendPK codes are confirmed arriving on the live site —
# on the next login, every bridge-verified account then re-verifies once with a
# real code (phone_verified_via 'bridge' → 'otp') and any paused plan reactivates.
BRIDGE_OTP=
BRIDGE_OTP_EXPIRES=

# Absolute site URL, used to build links inside emails. Without it, links fall
# back to https://tutormint.org.
NEXT_PUBLIC_SITE_URL=

# -------------------------------------------------------------- support ----
# Shown on /support. Overridden by app_settings rows (support.whatsapp,
# support.email, support.hours), so these are the fallback for a fresh
# environment. A channel with no value configured is not shown at all.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=

# ------------------------------------------------------- environment ------
# VERCEL_ENV is set by Vercel, never by you: 'production' | 'preview' |
# 'development'. lib/env.ts reads it to decide whether this is the live site,
# because a preview deployment is a `next build` and its NODE_ENV is
# 'production' too. Gating dev switches on NODE_ENV would turn them off on the
# one deployment that needs them.
#
# It governs test conveniences only -- DEV_DEFAULT_OTP, the payment simulator,
# /dev/*, the console adapters, the seed scripts. Row-level security, auth,
# entitlements, rate limits and the security headers are unaffected everywhere.
#
# Locally there is no VERCEL_ENV and NODE_ENV decides, so `next build &&
# next start` still behaves like production.
#
# See "Preview environment" in PRODUCTION_CHECKLIST.md for which variables
# belong on which Vercel environment.

# social profiles (optional)
#
# The footer renders an icon only for a profile that is configured here, and
# lib/seo.ts puts the same set in Organization.sameAs. A guessed URL is worse
# than a missing icon: it sends members to somebody else's account, and in
# sameAs it is an identity claim about a stranger. Set the ones that exist and
# leave the rest unset.
#
# X and TikTok are filled in below because the owner supplied the real
# handles on 4 Sep 2026. ADD BOTH TO VERCEL PRODUCTION (and Preview) — this
# file is a template and is not read at runtime, so until they are set in the
# Vercel environment the live footer shows three icons and sameAs carries
# three entries. The icons themselves already exist: public/x.png and
# public/tiktok.png.
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_X=https://x.com/TutorMint5
SOCIAL_TIKTOK=https://www.tiktok.com/@tutormint.official

# (NEXT_PUBLIC_PREVIEW_MODE was removed on 9 Sep 2026. Indexing had already been
# decoupled from it, and the "launching soon" banner it drove is gone — the site
# presents as live. The variable is no longer read anywhere; unset it in Vercel.)

# --------------------------------------------------------------- Claude API --
# "Write this for me" on the post-a-tuition form: turns the parent's SELECTIONS
# (level, subjects, city, area, mode, budget band, days) into a title and
# description. SERVER ONLY — never NEXT_PUBLIC_. lib/ai/anthropic.ts imports
# 'server-only', so a client component importing it is a build error rather
# than a leaked billable credential.
#
# OPTIONAL. With no key the form composes the same two fields from the
# selections itself and says so. Nobody is ever blocked from posting a job
# because a generation call could not be made.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
ANTHROPIC_MODEL=
