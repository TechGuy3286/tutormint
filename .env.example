# Supabase (the only backend)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred name for the browser key; ANON_KEY is the legacy fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never NEXT_PUBLIC_, never imported from a client component.
# Used for tables no browser may touch: phone_otps, notifications,
# usage_counters, subscriptions, the audit and activity logs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection. Used only by scripts/ (seed, schema verification),
# never by the app.
SUPABASE_DB_URL=

# YouTube Data API — tutor verification videos, uploaded as private
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must point at /api/auth/youtube/callback (moved: /api/auth/callback is now
# the Supabase email-confirmation handler).
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=

# Development only: a fixed OTP code that always passes, so multiple test
# users can verify a phone number. Never read when NODE_ENV=production.
DEV_DEFAULT_OTP=000000

# ---------------------------------------------------------------- payments --
# See "Payments" in CLAUDE.md for the adapter contract.

# AssanPay. The gateway is unreachable until ALL FOUR of these are set, so a
# half-configured deploy falls back to manual transfer rather than sending a
# member to a checkout that cannot complete. Field names inside the adapter are
# marked TODO(assanpay) until their documentation is in hand.
ASSANPAY_BASE_URL=
ASSANPAY_MERCHANT_ID=
ASSANPAY_API_KEY=
ASSANPAY_WEBHOOK_SECRET=

# Test gateway. Requires NODE_ENV != production AND both of these; there is no
# default secret anywhere in the code, because a signature check that passes
# with no secret is not a check.
PAYMENTS_SIMULATOR=false
PAYMENTS_SIMULATOR_SECRET=

# Daily subscription sweep (/api/cron/subscriptions), sent by Vercel Cron as
# `Authorization: Bearer <secret>`. When unset the route refuses everything:
# an open endpoint that expires subscriptions is a denial of service.
CRON_SECRET=

# Manual-transfer account details. Overridden by app_settings rows
# (pay.bank_name, pay.account_title, pay.iban, pay.jazzcash, pay.easypaisa) so
# an admin can change them without a deploy. A channel with no details is not
# offered to members rather than shown blank.
MANUAL_PAY_BANK_NAME=
MANUAL_PAY_ACCOUNT_TITLE=
MANUAL_PAY_IBAN=
MANUAL_PAY_JAZZCASH=
MANUAL_PAY_EASYPAISA=

# ------------------------------------------------------------- delivery ----
# Email, through Resend. Without a key: development prints the message to the
# server log; PRODUCTION SENDS NOTHING and says so at startup. The sending
# domain must be verified in Resend or every send is rejected.
RESEND_API_KEY=
# Optional override. Defaults to "TutorMint <noreply@tutormint.org>".
MAIL_FROM=

# SMS, through Twilio — one-time codes for phone verification. Either
# TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID is required, not both.
# Pakistan needs to be enabled in the Twilio account's geographic permissions,
# which is an account setting rather than anything in the code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Absolute site URL, used to build links inside emails. Without it, links fall
# back to https://tutormint.org.
NEXT_PUBLIC_SITE_URL=

# -------------------------------------------------------------- support ----
# Shown on /support. Overridden by app_settings rows (support.whatsapp,
# support.email, support.hours), so these are the fallback for a fresh
# environment. A channel with no value configured is not shown at all.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_HOURS=

# ------------------------------------------------------- environment ------
# VERCEL_ENV is set by Vercel, never by you: 'production' | 'preview' |
# 'development'. lib/env.ts reads it to decide whether this is the live site,
# because a preview deployment is a `next build` and its NODE_ENV is
# 'production' too. Gating dev switches on NODE_ENV would turn them off on the
# one deployment that needs them.
#
# It governs test conveniences only -- DEV_DEFAULT_OTP, the payment simulator,
# /dev/*, the console adapters, the seed scripts. Row-level security, auth,
# entitlements, rate limits and the security headers are unaffected everywhere.
#
# Locally there is no VERCEL_ENV and NODE_ENV decides, so `next build &&
# next start` still behaves like production.
#
# See "Preview environment" in PRODUCTION_CHECKLIST.md for which variables
# belong on which Vercel environment.
