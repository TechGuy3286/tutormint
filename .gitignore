# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# region migration secrets (Management API token, new DB password) — never commit
.env.migration

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps — contain CNICs and phone numbers, never commit
/supabase/backups/*
# …except the region-migration manifest (sizes + checksums only, no data)
!/supabase/backups/region-migration/
/supabase/backups/region-migration/*
!/supabase/backups/region-migration/MANIFEST.md

# scratch: local screenshot evidence, never committed
.tmp-ui/
supabase/.temp/
