{
  "name": "tutormint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "rls:audit": "tsx scripts/rls-audit.ts",
