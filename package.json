    "test:delivery": "tsx --test scripts/test-delivery.ts",
    "check:contrast": "tsx scripts/contrast-check.ts",
    "test:jobcopy": "tsx --test scripts/test-jobcopy.ts",
    "test:grouping": "tsx --test scripts/test-grouping.ts",
    "migrate:avatars": "tsx scripts/migrate-data-uri-avatars.ts",
